OCDD_DEPLOYMENT_MODE=local
OCDD_DATABASE_PATH=./data/local/ocdd.sqlite3
# Set only for the cloud deployment, for example:
# OCDD_DATABASE_URL=postgresql+psycopg://<user>:<password>@postgres:5432/<database>
OCDD_DATABASE_URL=
OCDD_STORAGE_PATH=./data/local/artifacts
OCDD_ARTIFACT_TTL_SECONDS=3600
# Cloud S3 purger defaults: objects stop being readable five minutes before the
# 60-minute deletion ceiling; a separate sidecar scans every minute.
OCDD_ARTIFACT_PURGE_INTERVAL_SECONDS=60
OCDD_ARTIFACT_EXPIRY_SAFETY_MARGIN_SECONDS=300
OCDD_ARTIFACT_PURGER_HEALTH_MAX_AGE_SECONDS=180
# Cloud defaults: 10 MiB decoded artifact and enough JSON/base64 envelope
# overhead. Local mode defaults to 25 MiB unless explicitly overridden.
# OCDD_ARTIFACT_MAX_BYTES=10485760
# OCDD_ARTIFACT_REQUEST_MAX_BYTES=14046552
# These are a bounded single-process reference guard only. Public multi-worker
# deployments also require a distributed Valkey/API-gateway/WAF rate limit.
OCDD_CLOUD_CASE_CREATE_PER_MINUTE=30
OCDD_CLOUD_ARTIFACT_UPLOAD_PER_MINUTE=20
OCDD_CLOUD_VIN_DECODE_PER_MINUTE=30
OCDD_ANONYMOUS_CASE_TTL_DAYS=7
# Cross-worker upload/delete exclusion. Keep TTL above the maximum document-processing request.
OCDD_CASE_LEASE_TTL_SECONDS=300
OCDD_CASE_LEASE_WAIT_SECONDS=5
# Keep false unless requests pass through a deployment-owned authenticated
# account layer that binds every case to the logged-in principal.
OCDD_ACCOUNT_RETENTION_ENABLED=false
# Cloud case access is secured with API-issued per-case bearer capabilities.
# There is intentionally no shared default token to configure or log.
OCDD_API_URL=http://localhost:8000
NEXT_PUBLIC_OCDD_API_URL=http://localhost:8000
# Disabled by default. Enable only for explicit UI-development sample data.
NEXT_PUBLIC_OCDD_ENABLE_DEMO=false
# Valkey uses the Redis-compatible protocol; the variable name stays stable for
# Celery and existing local deployments.
OCDD_REDIS_URL=redis://valkey:6379/0
# `inline` is the safe/test default outside Compose. Compose selects `celery`.
OCDD_DOCUMENT_PROCESSOR=inline
OCDD_DOCUMENT_PROCESSOR_TIMEOUT_SECONDS=45
# Required in Celery mode. Generate with:
# python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
OCDD_WORKER_ENVELOPE_KEY=
# Required when starting the host-side OBD bridge. Generate a random local token;
# there is intentionally no checked-in runtime default.
OCDD_OBD_BRIDGE_TOKEN=
OCDD_CORS_ORIGINS=http://localhost:3000

# Optional local explanation provider. All calculations work without it, and
# the official project never requires a paid API key.
OCDD_LLM_PROVIDER=disabled
OCDD_OLLAMA_MODEL=
OCDD_OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=

# Optional cloud storage/provider credentials.
OCDD_S3_ENDPOINT_URL=
OCDD_S3_BUCKET=
OCDD_S3_PREFIX=ocdd-transient
OCDD_S3_KMS_KEY_ID=
OCDD_S3_REGION=us-east-1
OCDD_S3_SSE=AES256
OCDD_S3_CONNECT_TIMEOUT_SECONDS=5
OCDD_S3_READ_TIMEOUT_SECONDS=10
OCDD_S3_MAX_ATTEMPTS=3
